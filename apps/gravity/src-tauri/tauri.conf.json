{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gravity",
  "version": "0.1.0",
  "identifier": "dev.fathom.gravity",
  "build": {
    "beforeDevCommand": "npm run dev --workspace gravity-ui",
    "beforeBuildCommand": "npm run build --workspace gravity-ui",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gravity - fathom",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "transparent": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
